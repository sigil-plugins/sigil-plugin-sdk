  "host_mapping": {
    "unavailable": "transport",
    "io": "transport",
    "timeout": "timeout",
    "limit": "limit",
    "denied": "outer-review",
    "tls": "outer-review",
    "configuration": "outer-review",
    "internal": "outer-review",
    "epoch": "outer-review-no-result"
  }
